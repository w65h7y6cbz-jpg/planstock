{
  "name": "planstock",
  "version": "0.2.0",
  "private": true,
  "description": "Plan interactif du stock par référence — Worker Cloudflare + base D1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix web run build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply planstock --remote",
    "db:migrate:local": "wrangler d1 migrations apply planstock --local",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "vitest run",
    "test:web": "npm --prefix web run test"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
