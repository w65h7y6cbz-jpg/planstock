{
  "name": "planstock",
  "version": "0.1.0",
  "private": true,
  "description": "Plan interactif du stock par référence (application locale SAV)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "npm --prefix web run build",
